# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets — never commit real credentials
.env

# Data — regenerable via etl.py, not source code. Downloaded PDFs bloat

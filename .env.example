# PaperGraph — environment variables
# Copy this file to .env and fill in real values. Never commit .env itself
# (.gitignore should already exclude it — see note at bottom).

# --- Neo4j AuraDB Free -------------------------------------------------
# From the credentials .txt file downloaded when you created the instance
# at https://neo4j.com/product/auradb/ (console.neo4j.io)
# URI looks like: neo4j+s://xxxxx.databases.neo4j.io
# NOTE: AuraDB's own credentials file uses NEO4J_USERNAME (not NEO4J_USER) —
# copy the values straight from that file, keys included.
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-auradb-password
NEO4J_DATABASE=neo4j

# --- Qdrant Cloud Free ---------------------------------------------------
# From https://cloud.qdrant.io after creating a free cluster
# URL looks like: https://xyz-example.region.aws.cloud.qdrant.io:6333
QDRANT_URL=https://xyz-example.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=papergraph_chunks

# --- Gemini (Google AI Studio, not Vertex) --------------------------------
# From https://aistudio.google.com/apikey — free tier, no card required
GOOGLE_API_KEY=your-google-ai-studio-key

# --- Model config ----------------------------------------------------------
# Overrides the default in agents.py if set
PAPERGRAPH_MODEL=gemini-2.5-flash

# --- Mem0 --------------------------------------------------------------
# No key needed — Mem0Tools runs a local Memory instance by default.
# Leave unset unless you later switch to Mem0's hosted platform.
# MEM0_API_KEY=

# --- arXiv ETL (used by etl.py, not yet built) ----------------------------
# arXiv's API itself needs no key; this is here as a placeholder for any
# future rate-limit-friendly identifier (e.g. a contact email in the
# User-Agent header, per arXiv's API etiquette guidelines).
ARXIV_CONTACT_EMAIL=your-email@example.com

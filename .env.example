# PaperGraph — environment variables (copy to .env; never commit .env).
# Every value has a working default for the public demo; you only need
# this file for the full stack, the ETL, or local experiments.

# --- Storage profile -----------------------------------------------------
# demo : Qdrant embedded in-process + graph snapshot (snapshot/). Zero
#        external services. What Vercel / the container serve by default.
# full : Qdrant server + Neo4j server — the system of record; ingestion
#        and `etl.py export` run here. `docker compose up -d` provides both.
STORE_PROFILE=demo
# SNAPSHOT_DIR=snapshot

# --- Qdrant (full profile) -------------------------------------------------
# Local: http://localhost:6333 (docker compose). Hosted: Qdrant Cloud URL + key.
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=papergraph_chunks_v2

# --- Neo4j (full profile) --------------------------------------------------
# Local: bolt://localhost:7687 (docker compose, neo4j/papergraph).
# AuraDB: neo4j+s://xxxx.databases.neo4j.io with the credentials file's values.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=papergraph
# NEO4J_DATABASE=

# --- Embeddings ------------------------------------------------------------
# FastEmbed (ONNX, no torch). Changing the dense model means re-running
# ingest + export (the snapshot manifest records which model built it).
# DENSE_MODEL=BAAI/bge-small-en-v1.5
# DENSE_DIM=384
# ENABLE_RERANKER=false        # ms-marco MiniLM cross-encoder (~80 MB)
# MODEL_CACHE_DIR=             # defaults to /tmp/fastembed_cache on Vercel

# --- LLM keys --------------------------------------------------------------
# The API never uses server-side LLM keys while REQUIRE_BYOK=true (default):
# every live run uses the visitor's own key, sent per request.
REQUIRE_BYOK=true
# Only for the ETL / local CLI runs (with REQUIRE_BYOK=false):
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# PAPERGRAPH_MODEL=gemini-2.5-flash

# --- Abuse & capacity controls ------------------------------------------------
# Shared rate-limit counters across instances (recommended in production):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# QUERY_LIMIT_PER_MIN=6
# QUERY_LIMIT_PER_HOUR=40
# INGEST_LIMIT_PER_HOUR=3
# MAX_CONCURRENT_RUNS=40       # per instance; excess gets 503 + Retry-After
# MAX_RUNS_PER_CLIENT=2
# RUN_TIMEOUT_S=150
# CORS_ORIGINS=https://your-domain.example
# TRUST_PROXY_HEADERS=true

# --- Features --------------------------------------------------------------
# ENABLE_INGEST=               # defaults to true on the full profile only
# RECORD_RUNS_DIR=frontend/replays   # save real runs as keyless replays
# MOCK_LLM=false               # load testing only: scripted runs, real retrieval
